<!-- Window template. Folders open as tabs in the front window; a tab dragged out becomes its own window.
     Each tab is filled from the real page, so it always matches its page. -->
<template id="win-tpl">
  <section class="win" role="dialog" aria-modal="false">
    <header class="bar">
      <div class="tabs" role="tablist" aria-label="Open pages"></div>
      <span class="spacer"></span>
      <button class="ctl toc-btn" aria-label="Contents"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10"/></svg></button>
      <a class="open-page" href="/">Open as page</a>
      <div class="lights">
        <button class="light min-btn" aria-label="Minimize window" title="Minimize"><svg viewBox="0 0 12 12"><path d="M3 6h6"/></svg></button>
        <button class="light max-btn" aria-label="Expand window" title="Expand"><svg viewBox="0 0 12 12"><path d="M4 8V4h4M8 4L4 8" /></svg></button>
        <button class="light close-btn" aria-label="Close window" title="Close"><svg viewBox="0 0 12 12"><path d="M3.5 3.5l5 5M8.5 3.5l-5 5"/></svg></button>
      </div>
    </header>
    <span class="grip bl" data-edge="left" title="Drag to resize" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M14 5L5 14M14 10L10 14"/></svg></span>
    <span class="grip br" data-edge="right" title="Drag to resize" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M14 5L5 14M14 10L10 14"/></svg></span>
  </section>
</template>
<template id="pane-tpl">
  <div class="body" role="tabpanel">
    <nav class="toc" aria-label="Contents"><p>Contents</p><ol></ol></nav>
    <div class="read" tabindex="0"><article class="art"></article></div>
  </div>
</template>

<!-- Up to 3 recently opened pages that are not on screen, bottom right -->
<nav class="tray" id="tray" aria-label="Recent windows"></nav>

<!-- Asks before a folder leaves the site -->
<dialog class="leave" id="leave" aria-labelledby="leave-h">
  <form method="dialog">
    <h2 id="leave-h">Open in a new tab?</h2>
    <p id="leave-p"></p>
    <div class="leave-row">
      <button class="btn" value="cancel" autofocus>Cancel</button>
      <button class="btn solid" value="go">Open</button>
    </div>
  </form>
</dialog>
