---
// Shortcuts dock. On phones it is a floating pill that becomes a full-width bottom bar when the page scrolls (appbar.js). `sub` = inner pages.
const { sub = false, contact = '#contact' } = Astro.props;
---
  <nav class="dock" aria-label="Shortcuts">
    <a href="/work/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg><span class="tip">Work</span><span class="dl">Work</span></a>
    <a href="/resume.pdf" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l4 4v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v4h4M9 12h6M9 16h6"/></svg><span class="tip">Resume</span><span class="dl">Resume</span></a>
    <a href={contact} {...(sub ? {} : { "data-copy": "" })}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1zM3.5 7l8.5 6 8.5-6"/></svg><span class="tip" data-tip>Contact, copy email</span><span class="dl">Contact</span></a>
    {sub && <button type="button" class="dock-ask" data-ask-open><svg viewBox="0 0 90 100" aria-hidden="true"><rect x="10" y="12" width="70" height="72" rx="6"/><ellipse cx="32" cy="44" rx="8" ry="9"/><ellipse cx="58" cy="44" rx="8" ry="9"/><path d="M38 60c4 3 10 3 14 0"/></svg><span class="dl">Ask</span></button>}
    {!sub && <span class="sr" role="status" id="copy-status"></span>}
  </nav>
