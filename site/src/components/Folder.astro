---
// One desktop folder. `open` makes it open in a window instead of navigating ("kind" for Kind words, true for a case study).
const { href, label, glyph, art, tile, work, short, preview, previewText, open, external, mobileHide, tags } = Astro.props;
// art: full custom desktop icon (replaces the folder). tile: line glyph on a 24 grid for the phone app icon. short: shorter phone label.
const DEFAULT_GLYPH = '<rect class="glyph" x="22" y="22" width="12" height="12"/>';
---
<li class={mobileHide ? 'm-hide' : undefined}>
  <a class="folder" href={href} data-open={open === true ? '' : open} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
    <Fragment set:html={art
      ? '<svg class="obj" viewBox="0 0 56 46" aria-hidden="true">' + art + '</svg>'
      : '<svg viewBox="0 0 56 46" aria-hidden="true"><path class="back" d="M2 6a4 4 0 0 1 4-4h14l5 6h25a4 4 0 0 1 4 4v28a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4z"/><rect class="front" x="3" y="13" width="50" height="30" rx="3.5"/>' + (glyph || DEFAULT_GLYPH) + '</svg>'} />
    <span class="lbl">{short ? <>{short}<span class="l-rest">{label.slice(short.length)}</span></> : label}</span>
    {tile && <span class={'tile' + (work ? ' work' : '')} aria-hidden="true"><Fragment set:html={'<svg viewBox="0 0 24 24">' + tile + '</svg>'} /></span>}
    {(preview || previewText) && (
      <span class="peek" aria-hidden="true">{preview && <img data-src={preview} alt=""/>}<span>{previewText}</span>{tags && tags.length > 0 && <em class="ptags">{tags.map(t => <b>{t}</b>)}</em>}</span>
    )}
  </a>
</li>
