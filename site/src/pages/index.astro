---
import Base from '../layouts/Base.astro';
import HomeNav from '../components/HomeNav.astro';
import Folder from '../components/Folder.astro';
import Shapes from '../components/Shapes.astro';
import Dock from '../components/Dock.astro';
import Window from '../components/Window.astro';
import '../styles/home.css';
import { studies } from '../lib/content.mjs';
import glyphs from '../lib/home-glyphs.json';
import { links } from '../lib/links.mjs';

// Case studies come from the editor, in their set order. A study opens in the window when it has no locked section.
const work = studies().map(s => ({
  href: `/work/${s.slug}/`,
  label: s.meta.company + (s.meta.company === 'MAVI' ? ' Client Portal' : ''),
  glyph: glyphs[`/work/${s.slug}/`],
  preview: s.preview || (s.slug === 'mavi' ? '/img/preview-mavi.webp' : null),
  previewText: ({ mavi: 'A self-serve client portal, aligned across five teams in two weeks.', copperleaf: 'Research, three tested ideas and a shipped guide for an enterprise tool.' })[s.slug] || s.meta.summary,
  open: true,
}));
const about = 'Senior product designer in Vancouver, making complex software easier to use.';
const extras = [
  { href: '/about/', label: 'About', open: 'about', glyph: '<circle class="glyph" cx="28" cy="28" r="6.5"/>', preview: '/img/jarell-alvarez.webp', previewText: about },
  { href: links.vdc, label: 'Community', preview: '/img/preview-vdc.webp', glyph: '<circle class="glyph" cx="23" cy="28" r="4.5"/><circle class="glyph" cx="33" cy="28" r="4.5"/>', external: true, previewText: '4,200+ designers in Vancouver. Socials, talks and portfolio reviews.' },
  { href: links.photography, label: 'Photography', preview: '/img/preview-photography.webp', glyph: "<path class=\"glyph\" fill-rule=\"evenodd\" d=\"M28 21a7 7 0 1 1 0 14 7 7 0 0 1 0-14zm0 4a3 3 0 1 0 0 6 3 3 0 0 0 0-6z\"/>", external: true, previewText: 'Portraits, editorial and events. Opens jarell.photography.' },
  { href: '#kind', label: 'Kind words', glyph: '<path class="glyph" d="M19 22h8v6l-4 5h-3l2-5h-3zm11 0h8v6l-4 5h-3l2-5h-3z"/>', open: 'kind', preview: '/img/preview-kind.webp', previewText: '23 recommendations from people I\'ve worked with, managed and mentored.' },
];
---
<Base
  title="Jarell Alvarez, Senior Product Designer"
  description="Senior product designer and design lead in Vancouver. B2B SaaS, enterprise software and complex workflows made easier to use."
>
  <body>
<div class="doodle-bg" aria-hidden="true">
  <span class="dd" style="--d:url(/doodles/coffee.svg);left:3%;top:13%;width:74px;height:72px;rotate:-6deg"></span>
  <span class="dd" style="--d:url(/doodles/plane.svg);right:3%;top:13%;width:96px;height:64px;rotate:6deg"></span>
  <span class="dd" style="--d:url(/doodles/star.svg);left:3.5%;top:50%;width:32px;height:32px"></span>
  <span class="dd" style="--d:url(/doodles/curly.svg);right:2.5%;top:46%;width:96px;height:37px;rotate:-8deg"></span>
  <span class="dd" style="--d:url(/doodles/cursor.svg);left:16%;bottom:12%;width:27px;height:29px;rotate:-10deg"></span>
</div>
<div class="desk">
  <HomeNav />
  <main class="hero">
    <h1>Jarell Alvarez</h1>
    <p class="role">Senior Product Designer and Design Lead, Vancouver</p>
    <p class="tag">Good design starts with better questions.</p>

    <ul class="folders" id="work" aria-label="Work and more">
      {work.map(f => <Folder {...f} />)}
      {extras.map(f => <Folder {...f} />)}
    </ul>
  </main>

  <Shapes />
  <Dock />
</div>

<Window />
    <script is:inline src="/js/home.js"></script>
    <script is:inline src="/js/buddy.js"></script>
  </body>
</Base>
