---
import Base from '../layouts/Base.astro';
import HomeNav from '../components/HomeNav.astro';
import Folder from '../components/Folder.astro';
import Shapes from '../components/Shapes.astro';
import Rail from '../components/Rail.astro';
import Journey from '../components/Journey.astro';
import Dock from '../components/Dock.astro';
import Window from '../components/Window.astro';
import '../styles/home.css';
import '../styles/journey.css';
import { studies } from '../lib/content.mjs';
import glyphs from '../lib/home-glyphs.json';
import { links } from '../lib/links.mjs';

// Case studies come from the editor, in their set order. A study opens in the window when it has no locked section.
const work = studies().map(s => ({
  href: `/work/${s.slug}/`,
  label: s.meta.company + (s.meta.company === 'MAVI' ? ' Client Portal' : ''),
  glyph: glyphs[`/work/${s.slug}/`],
  tile: ({ mavi: '<rect x="3.5" y="4.5" width="17" height="15" rx="2.5"/><path d="M3.5 9h17M7 13h5M7 16h8"/>', copperleaf: '<path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14z"/><path d="M5 19l8-8"/>', 'ui-avenue': '<path d="M4 20h16"/><path d="M7 16v-4M12 16V7M17 16v-6"/>' })[s.slug] || '<rect x="3.5" y="4.5" width="17" height="15" rx="2.5"/><path d="M3.5 9h17M7 13h5M7 16h8"/>',
  work: true,
  short: s.meta.company === 'MAVI' ? 'MAVI' : undefined,
  preview: s.preview || (s.slug === 'mavi' ? '/img/preview-mavi.webp' : null),
  previewText: ({ mavi: 'A self-serve client portal, aligned across five teams in two weeks.', copperleaf: 'Research, three tested ideas and a shipped guide for an enterprise tool.' })[s.slug] || s.meta.summary,
  open: true,
  detail: { title: s.meta.title, sub: [s.meta.company, s.meta.role].join(' \u00b7 '), stat: (s.meta.stats || [])[0], tags: s.meta.tags || [] },
}));
const about = 'Senior product designer in Vancouver, making complex software easier to use.';
const extras = [
  { href: '/about/', label: 'About', art: '<rect class="obj-back" x="15" y="3" width="28" height="40" rx="2.5" transform="rotate(7 29 23)"/><path class="obj-bg" d="M16 2h16l9 9v31a2 2 0 0 1-2 2H16a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/><path class="obj-line" d="M32 2.5v6.5a2 2 0 0 0 2 2h6.5"/><g class="obj-ink"><circle cx="21.5" cy="12" r="3.3"/><rect x="18.5" y="20" width="18" height="2.6" rx="1.3"/><rect x="18.5" y="25.6" width="18" height="2.6" rx="1.3"/><rect x="18.5" y="31.2" width="11" height="2.6" rx="1.3"/></g>', tile: '<circle cx="12" cy="8.5" r="3.5"/><path d="M5 20c.8-3.8 3.6-6 7-6s6.2 2.2 7 6"/>', open: 'about', glyph: '<circle class="glyph" cx="28" cy="28" r="6.5"/>', preview: '/img/jarell-alvarez.webp', previewText: about },
  { href: links.vdc, label: 'Community', art: '<rect class="obj-solid" x="6" y="1" width="44" height="44" rx="11"/><g class="obj-knock"><path d="M13 15h7v16h-3a4 4 0 0 1-4-4z"/><path d="M22.5 15l14 16h-14z"/><rect x="38" y="23" width="7" height="8"/></g>', tile: '<circle cx="9" cy="9" r="3"/><circle cx="16.5" cy="10" r="2.5"/><path d="M3.5 19c.6-3 2.8-5 5.5-5s4.9 2 5.5 5M14.5 15c2.6-.6 5 .9 6 4"/>', preview: '/img/preview-vdc.webp', glyph: '<circle class="glyph" cx="23" cy="28" r="4.5"/><circle class="glyph" cx="33" cy="28" r="4.5"/>', external: true, previewText: '4,200+ designers in Vancouver. Socials, talks and portfolio reviews.' },
  { href: links.photography, label: 'Photography', art: '<path class="obj-bg" d="M8 12h8l4-6h16l4 6h8a4 4 0 0 1 4 4v22a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V16a4 4 0 0 1 4-4z"/><circle class="obj-ink" cx="28" cy="26.5" r="10"/><circle class="obj-knock" cx="28" cy="26.5" r="5.2"/><circle class="obj-ink" cx="26.3" cy="24.8" r="1.6"/><rect class="obj-ink" x="42" y="16" width="6" height="3.2" rx="1.2"/>', tile: '<path d="M4 8.5h3l1.6-2.5h6.8L17 8.5h3v10H4z"/><circle cx="12" cy="13" r="3.2"/>', preview: '/img/preview-photography.webp', glyph: "<path class=\"glyph\" fill-rule=\"evenodd\" d=\"M28 21a7 7 0 1 1 0 14 7 7 0 0 1 0-14zm0 4a3 3 0 1 0 0 6 3 3 0 0 0 0-6z\"/>", external: true, previewText: 'Portraits, editorial and events. Opens jarell.photography.' },
  { href: '#kind', label: 'Kind words', art: '<rect class="obj-back" x="5" y="1.5" width="48" height="32" rx="4" transform="rotate(-4 29 18)"/><path class="obj-bg" d="M7 7h42a4 4 0 0 1 4 4v24a4 4 0 0 1-4 4H20l-8 6v-6H7a4 4 0 0 1-4-4V11a4 4 0 0 1 4-4z"/><path class="obj-ink" transform="translate(0 -6)" d="M19 22h8v6l-4 5h-3l2-5h-3zm11 0h8v6l-4 5h-3l2-5h-3z"/><rect class="obj-ink" x="18" y="30" width="20" height="2.6" rx="1.3"/>', mobileHide: true, glyph: '<path class="glyph" d="M19 22h8v6l-4 5h-3l2-5h-3zm11 0h8v6l-4 5h-3l2-5h-3z"/>', open: 'kind', preview: '/img/preview-kind.webp', previewText: '23 recommendations from people I\'ve worked with, managed and mentored.' },
];
---
<Base
  title="Jarell Alvarez, Senior Product Designer"
  description="Senior product designer and design instructor in Vancouver. B2B SaaS, enterprise software and complex workflows made easier to use."
>
  <body>
<div class="desk">
  <HomeNav />
  <main class="hero">
    <div class="hero-copy">
      <div class="hero-art" aria-hidden="true">
        <span class="dd" data-art="coffee" style="left:-3.6rem;top:-3.4rem;width:64px;rotate:-6deg"></span>
        <span class="dd" data-art="airplane" style="right:-3.8rem;top:-3.6rem;width:84px;rotate:6deg"></span>
        <span class="dd" data-art="squiggly-arrow" style="left:-6.2rem;bottom:-.9rem;width:84px;rotate:-8deg"></span>
        <span class="dd" data-art="star" style="right:-2.4rem;bottom:.2rem;width:30px"></span>
        <span class="dd" data-art="volleyball" style="right:-5.8rem;bottom:-.2rem;width:42px"></span>
        <span class="dd" data-art="cursor" style="left:6%;bottom:-2.4rem;width:26px;rotate:-10deg"></span>
      </div>
      <h1>Jarell Alvarez</h1>
      <p class="role">Senior Product Designer and Design Instructor, Vancouver</p>
      <p class="tag">Good design starts with better questions.</p>
    </div>

    <ul class="folders" id="work" aria-label="Work and more">
      {work.map(f => <Folder {...f} />)}
      {extras.map(f => <Folder {...f} />)}
    </ul>
  </main>

  <Shapes />
  <Dock />
</div>
<Journey wins={work.map(f => ({ href: f.href, label: f.label, text: f.previewText, preview: f.preview, ...f.detail }))} pvs={extras.map(f => ({ href: f.href === '#kind' ? '/kind-words/' : f.href, label: f.label, preview: f.preview, external: !!f.external }))} />
<Rail />

<Window />
    <script is:inline src="/js/home.js"></script>
    <script is:inline src="/js/buddy.js"></script>
    <script is:inline src="/js/journey.js"></script>
  </body>
</Base>
