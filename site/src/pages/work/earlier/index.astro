---
import Page from '../../../layouts/Page.astro';
import WorkCard from '../../../components/WorkCard.astro';
import Mark from '../../../components/Mark.astro';
import { studies } from '../../../lib/content.mjs';
const earlier = studies('earlier');
---
<Page title="Earlier work, Jarell Alvarez" description="Case studies from 2017 to 2019, kept as they were written.">
  <h1 class="page-title">Earlier work</h1>
  <p class="page-sub">Projects from 2017 to 2019, kept as I wrote them at the time. For recent work, start with <a href="/work/">Work</a>.</p>
  <div class="cards">
    {earlier.map(m => <WorkCard href={`/work/earlier/${m.slug}/`} company={m.meta.company} title={m.meta.title} summary={m.meta.summary} preview={m.preview} />)}
  </div>
  <Mark />
</Page>
