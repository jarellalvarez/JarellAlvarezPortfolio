---
import Page from '../../layouts/Page.astro';
import WorkCard from '../../components/WorkCard.astro';
import Mark from '../../components/Mark.astro';
import { studies, EARLIER } from '../../lib/content.mjs';
const featured = studies();
---
<Page title="Work, Jarell Alvarez" description="Product design case studies: MAVI client portal, Copperleaf Framework Designer, UI Avenue analytics, and earlier work.">
  <h1 class="page-title">Work</h1>
  <p class="page-sub">Three recent projects, then the older ones as I wrote them at the time.</p>
  <div class="cards">
    {featured.map(m => <WorkCard href={`/work/${m.slug}/`} company={m.meta.company} title={m.meta.title} summary={m.meta.summary} preview={m.preview} />)}
  </div>
  <h2 class="h-sec">Earlier work</h2>
  <div class="list">
    {EARLIER.map(e => <a href={e.href}><strong>{e.title}</strong><small>{e.note}</small></a>)}
  </div>
  <Mark />
</Page>
