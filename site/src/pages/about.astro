---
import Page from '../layouts/Page.astro';
import Quote from '../components/Quote.astro';
import Mark from '../components/Mark.astro';
import EmailButton from '../components/EmailButton.astro';
import { about, testimonials } from '../lib/content.mjs';
const { html, meta } = about();
const [intro, ...rest] = html.split('</p>');
const quotes = testimonials().filter(t => t.place === 'about');
---
<Page title="About Jarell Alvarez" description="Senior product designer in Vancouver. Founder of Vancouver Design Community, UX/UI instructor at BCIT, photographer.">
  <img class="hero-photo" src={meta.photo} alt="Jarell Alvarez" width="1356" height="1356" />
  <div class="story about">
    <Fragment set:html={intro + '</p>'} />
    <div class="links">
      <a class="btn solid" href="/resume.pdf" target="_blank" rel="noopener">Resume</a>
      <EmailButton />
      <a class="btn" href="https://ca.linkedin.com/in/jarellalvarez" target="_blank" rel="noopener">Connect with me on LinkedIn</a>
    </div>
    <Fragment set:html={rest.join('</p>')} />
  </div>
  <h2 class="h-sec">Kind words</h2>
  <div class="saids">{quotes.map(q => <Quote {...q} />)}</div>
  <p style="margin-top:1.25rem"><a href="/kind-words/">Read the rest</a></p>
  <Mark />
</Page>
