---
import Page from '../layouts/Page.astro';
import Quote from '../components/Quote.astro';
import Mark from '../components/Mark.astro';
import EmailButton from '../components/EmailButton.astro';
import { about, testimonials } from '../lib/content.mjs';
const { html, meta } = about();
const [intro, ...rest] = html.split('</p>');
// Show the first blurb, then fade into "Read more" from Teaching onward
const restHtml = rest.join('</p>'), cut = restHtml.search(/<h2[^>]*>[^<]*Teaching/);
let [shown, more] = cut > 0 ? [restHtml.slice(0, cut), restHtml.slice(cut)] : [restHtml, ''];
shown = shown.replace(/<p>Chat with me about:?<\/p>/, '<h2 id="chat" class="h-sec">Chat with me about</h2>');
const timeline = meta.timeline || [];
const quotes = testimonials().filter(t => t.place === 'about');
---
<Page title="About Jarell Alvarez" description="Senior product designer in Vancouver. Founder of Vancouver Design Community, UX/UI instructor at BCIT, photographer.">
  <div class="about-top">
    <img class="hero-photo" src={meta.photo} alt="Jarell Alvarez" width="1356" height="1356" />
    <span class="dd portrait" data-art="self-portrait" aria-hidden="true"></span>
  </div>
  <div class="story about">
    <Fragment set:html={intro + '</p>'} />
    <div class="links">
      <a class="btn solid" href="/resume.pdf" target="_blank" rel="noopener">Resume</a>
      <EmailButton />
      <a class="btn" href="https://www.linkedin.com/in/jarellalvarez/" target="_blank" rel="noopener">Connect with me on LinkedIn</a>
      <a class="btn" href="https://magnificent-mantis-ff1.notion.site/Learn-More-About-Jarell-2f86f335025548ddb921df662409a659" target="_blank" rel="noopener">Podcasts, talks and videos</a>
    </div>
    {meta.summary && <><h2 class="h-sec">At a glance</h2><p class="exec">{meta.summary}</p></>}
    {timeline.length > 0 && <>
    <h2 class="h-sec">Work history</h2>
    <ol class="timeline clamp">{timeline.map(t => <li><span class="yr">{t.years}</span><strong>{t.role}</strong><span>{t.org}</span>{t.note && <span class="tl-note">{t.note}</span>}</li>)}</ol>
    <button class="rm" aria-expanded="false">Read more</button>
  </>}
    <Fragment set:html={shown} />
    {more && <><div class="clamp about-more"><Fragment set:html={more} /></div><button class="rm" aria-expanded="false">Read more</button></>}
  </div>
  <h2 class="h-sec">Kind words</h2>
  <div class="saids">{quotes.map(q => <Quote {...q} />)}</div>
  <p style="margin-top:1.25rem"><a href="/kind-words/">Read the rest</a></p>
  <Mark />
</Page>
