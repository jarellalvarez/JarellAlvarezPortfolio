---
import '../styles/tokens.css';
import '../styles/themes.css';
import '../styles/style-panel.css';
import '../styles/ask.css';
import '../styles/illustrations.css';
import '../styles/lightbox.css';
import '../styles/appbar.css';
const { title, description, noindex = false } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-theme="light" data-palette="ivory" data-font="bricolage" data-size="l">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={url} />
    <link rel="icon" href="/img/jarell_alvarez_Favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/img/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <meta name="theme-color" content="#f7f4ec" />
    <link rel="preload" href="/fonts/bricolage.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL("/img/og.jpg", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>try{var d=document.documentElement,g=function(k){return localStorage.getItem("style-"+k)};if(g("mode"))d.dataset.theme=g("mode");if(g("palette"))d.dataset.palette=g("palette");if(g("font"))d.dataset.font=g("font");if(g("size"))d.dataset.size=g("size")}catch(e){}</script>
    <slot name="head" />
  </head>
  <slot />
  <script is:inline src="/js/appbar.js"></script>
  <script is:inline src="/js/style.js"></script>
  <script is:inline src="/js/back.js"></script>
  <script is:inline src="/js/ask.js"></script>
  <script is:inline src="/js/chat.js"></script>
  <script is:inline src="/js/chatpanel.js"></script>
  <script is:inline src="/js/illustrations.js"></script>
  <script is:inline src="/js/lightbox.js"></script>
</html>
