---
// Standard page: header, main column, contact block, shared styles and scripts.
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Cta from '../components/Cta.astro';
import '../styles/site.css';
const { cta = true, bodyClass = '', ...rest } = Astro.props;
---
<Base {...rest}>
  <body class={bodyClass}>
    <Header />
    <main>
      <a class="back" href="/" id="back-link">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
        <span id="back-label">Back to Home</span>
      </a>
      <slot />
      {cta && <Cta />}
    </main>
    <slot name="after" />
    <script is:inline src="/js/site.js"></script>
  </body>
</Base>
